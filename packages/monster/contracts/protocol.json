{
  "protocol_version": 1,
  "transport": "gradio",
  "authentication": "username-password",
  "endpoints": {
    "heartbeat": [],
    "rig_candidates": ["monster_id", "input_glb_file", "run_auto_audit"],
    "train_monster_probe": [
      "monster_id",
      "custom_blend_file",
      "custom_meta_json",
      "num_samples",
      "epochs",
      "auto_shutdown_after"
    ],
    "reexam_only": [
      "monster_id",
      "rerender_exam",
      "auto_shutdown_after"
    ],
    "generate_actions_batch": [
      "monster_id",
      "actions_csv",
      "bake_glb_on_cloud",
      "auto_shutdown_after"
    ],
    "shutdown": ["reason"]
  },
  "file_outputs": {
    "rig_candidates": ["rig_metadata_json", "rig_bundle_zip"],
    "generate_actions_batch": ["batch_summary_json", "animations_bundle_zip"]
  }
}
